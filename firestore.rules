rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Each user can only read their own recorded fortune history.
    // All writes happen server-side from Cloud Functions (Admin SDK bypasses
    // rules), so clients never get write access here.
    match /users/{userId}/fortunes/{fortuneId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false;
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
